# Copy to .env and change these before running docker compose for real use.
# docker-compose.yml reads this file automatically.

POSTGRES_USER=hskgo
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=hskgo
POSTGRES_PORT=5432

# Password to sign in at /admin/login.
ADMIN_PASSWORD=change-this-password-too

# Random long string used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
